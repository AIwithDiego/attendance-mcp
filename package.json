{
  "name": "attendance-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets an AI assistant analyse staff attendance: late arrivals, repeat lateness, no-shows and per-site trends.",
  "type": "module",
  "bin": {
    "attendance-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "inspect": "mcp-inspector tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.8.0",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
